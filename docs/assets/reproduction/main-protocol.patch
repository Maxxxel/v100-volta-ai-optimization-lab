+bool llama_sampler_accept_grammar_prefill(llama_sampler * sampler, const char * text, size_t size) {
+    if (!sampler || sampler->iface != &llama_sampler_grammar_i || !text) {
+        return false;
+    }
+    auto * ctx = (llama_sampler_grammar *) sampler->ctx;
+    if (!ctx->grammar || ctx->grammar->lazy) {
+        return false;
+    }
+    if (size > 65536 || std::memchr(text, '\0', size)) {
+        throw std::runtime_error("invalid grammar prefill text");
+    }
+    for (const auto & rule : ctx->grammar->rules) {
+        for (const auto & element : rule) {
+            if (element.type == LLAMA_GRETYPE_TOKEN || element.type == LLAMA_GRETYPE_TOKEN_NOT) {
+                return false;
+            }
+        }
+    }
+    llama_grammar_accept_str(*ctx->grammar, std::string(text, size));
+    return true;
+}
