+static void test_grammar_text_prefill() {
+    const char * definition = "root ::= \"<|im_start|>assistant\\n\" \"DONE\"\n";
+    const std::string prefix = "<|im_start|>assistant\n";
+    auto * grammar = llama_sampler_init_grammar(nullptr, definition, "root");
+    GGML_ASSERT(grammar);
+    GGML_ASSERT(llama_sampler_accept_grammar_prefill(grammar, prefix.data(), prefix.size()));
+    GGML_ASSERT(llama_sampler_accept_grammar_prefill(grammar, "DONE", 4));
+    bool rejected = false;
+    try {
+        llama_sampler_accept_grammar_prefill(grammar, "X", 1);
+    } catch (const std::exception &) {
+        rejected = true;
+    }
+    GGML_ASSERT(rejected);
+    llama_sampler_free(grammar);
+
+    const std::vector<std::string> invalid = {
+        "<|im_start|> assistant\n", std::string(65537, 'x'), std::string("a\0b", 3)
+    };
+    for (const auto & text : invalid) {
+        grammar = llama_sampler_init_grammar(nullptr, definition, "root");
+        rejected = false;
+        try {
+            llama_sampler_accept_grammar_prefill(grammar, text.data(), text.size());
+        } catch (const std::exception &) {
+            rejected = true;
+        }
+        GGML_ASSERT(rejected);
+        llama_sampler_free(grammar);
+    }
+
+    grammar = llama_sampler_init_grammar(nullptr, "root ::= <[1]>\n", "root");
+    GGML_ASSERT(grammar);
+    GGML_ASSERT(!llama_sampler_accept_grammar_prefill(grammar, prefix.data(), prefix.size()));
+    llama_sampler_free(grammar);
+    grammar = llama_sampler_init_grammar_lazy_patterns(nullptr, definition, "root", nullptr, 0, nullptr, 0);
+    GGML_ASSERT(!llama_sampler_accept_grammar_prefill(grammar, prefix.data(), prefix.size()));
+    llama_sampler_free(grammar);
+    auto * sampler = llama_sampler_init_top_k(3);
+    GGML_ASSERT(!llama_sampler_accept_grammar_prefill(sampler, prefix.data(), prefix.size()));
+    llama_sampler_free(sampler);
+}
+
 int main(void) {
     ggml_time_init();
 
+    test_grammar_text_prefill();
+
     test_dist_singleton_rng();
 
     test_temp({0.1f, 0.2f, 0.3f, 0.4f}, {0.1f, 0.2f, 0.3f, 0.4f}, 1.0f);
